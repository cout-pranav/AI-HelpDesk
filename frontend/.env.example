# Copy to .env (or .env.local for machine-specific overrides, which is git-ignored).
# Only VITE_-prefixed variables are exposed to the frontend, and they end up in the
# built bundle, so never put secrets here.

# Base URL of the TicketManagement.Api backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:5280

# .env.e2e (committed) overrides this for Playwright runs (`vite --mode e2e`) with the
# E2E backend at http://localhost:5281.
