{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TicketManagement.Api",
    "Audience": "TicketManagement.Frontend",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Sentry": {
    // Dsn is set per machine/deployment (user-secrets or Sentry__Dsn); Sentry is off without it.
    // Request bodies and PII stay off: tickets hold customers' emails and names.
    "SendDefaultPii": false,
    "MaxRequestBodySize": "None",
    "MinimumEventLevel": "Error"
  },
  "SendGrid": {
    "FromEmail": "help@pranavsupport.online",
    "FromName": "Support"
  }
}
