# docker compose settings. Copy to .env (git-ignored) and fill in.

# Host port for the app (default 8080).
APP_PORT=8080

# SQL Server sa password: 8+ chars with three of upper, lower, digit, symbol.
DB_PASSWORD=
# JWT HMAC key, at least 32 bytes, e.g. a base64 string of 48 random bytes.
JWT_SIGNING_KEY=

# Admin created on first start (skipped if empty; never updates an existing user).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Administrator

# Optional. Each feature is off when its value is empty.
INBOUND_EMAIL_SECRET=
GEMINI_API_KEY=
SENDGRID_API_KEY=
SENTRY_DSN=

# Optional, baked into the frontend bundle at build time (public, local demo only).
VITE_GEMINI_API_KEY=
VITE_SENTRY_DSN=
